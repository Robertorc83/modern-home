# Copy to .env. Everything works with these defaults: no keys, no accounts.

# Optional. When set, natural language availability is parsed by Claude (claude-haiku-5-5).
# When empty, a deterministic rule based parser is used.
ANTHROPIC_API_KEY=

# Change for anything that is not a local demo (at least 32 characters).
JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef

# URL shown on the "Connect an AI assistant" page.
PUBLIC_MCP_URL=http://localhost:5080/mcp
